# Optional. Without a key the app still scores resumes and does rule-based
# (no LLM) tailoring. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for rewriting and cover letters
TALENTTUNE_MODEL=claude-sonnet-4-6

# Where run history is stored (SQLite)
TALENTTUNE_DB=talenttune.db

# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8000

MAX_UPLOAD_MB=5
